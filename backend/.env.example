# Database Connection
# ---------------------------------------------------------------------------------------
# Option A: Neon PostgreSQL (Production on Render)
# Format: postgresql://<user>:<password>@<neon_host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_YourPasswordHere@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: MS SQL Server (Local Development via pyodbc)
# DATABASE_URL=mssql+pyodbc://sa:YourStrongPassword123@localhost:1433/task_expense_db?driver=ODBC+Driver+17+for+SQL+Server
# ---------------------------------------------------------------------------------------

# JWT Security
JWT_SECRET_KEY=replace_this_with_a_very_long_secure_random_hex_string_32_bytes_at_least
JWT_REFRESH_SECRET_KEY=replace_this_with_another_very_long_secure_random_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
PROJECT_NAME="QuestFlow"
API_V1_STR=/api/v1
ENVIRONMENT=development
