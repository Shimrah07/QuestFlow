# Database Connection (MS SQL Server using pyodbc)
# Format: mssql+pyodbc://<username>:<password>@<host>:<port>/<database>?driver=ODBC+Driver+17+for+SQL+Server
DATABASE_URL=mssql+pyodbc://sa:YourStrongPassword123@localhost:1433/task_expense_db?driver=ODBC+Driver+17+for+SQL+Server

# JWT Security
JWT_SECRET_KEY=replace_this_with_a_very_long_secure_random_hex_string_32_bytes_at_least
JWT_REFRESH_SECRET_KEY=replace_this_with_another_very_long_secure_random_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
PROJECT_NAME="Gamified Task & Expense Management System"
API_V1_STR=/api/v1
ENVIRONMENT=development
