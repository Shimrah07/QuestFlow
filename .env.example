# QuestFlow Environment Variables Configuration Template

PROJECT_NAME="QuestFlow"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration
# Option A: Neon PostgreSQL (Production Deployment on Render)
DATABASE_URL="postgresql://neondb_owner:npg_YourPasswordHere@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Option B: MS SQL Server (Local Development via PyODBC)
# DATABASE_URL="mssql+pyodbc://localhost/TaskExpenseDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes"

# JWT Token Security (Replace with secure random keys in production)
JWT_SECRET_KEY="your-secure-access-token-secret-key-32-bytes-minimum"
JWT_REFRESH_SECRET_KEY="your-secure-refresh-token-secret-key-32-bytes-minimum"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
